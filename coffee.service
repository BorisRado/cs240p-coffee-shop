# The coffee shop as a systemd service.
# systemd starts it at every boot and restarts it if it crashes.
# (User data runs only once, at the first boot.)
[Unit]
Description=CS 240P coffee shop
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/coffee/shop.py
EnvironmentFile=-/etc/coffee.env
# Run as a throw-away user, not as root. It may still use port 80.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
